# Autostart saat boot & restart otomatis bila crash (Jetson Orin Nano).
# Pasang dengan:  bash scripts/pasang_service.sh
[Unit]
Description=Deteksi pelanggaran Pelican Crossing (DeepStream 9.1 + YOLO26n + PLC)
After=network-online.target nvpmodel.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=HEADLESS=1
Environment=HOME=__HOME__
Environment=NVDS_DISABLE_CUDADEV_BLOCKINGSYNC=1
# Pengaturan PLC (hapus tanda # dan sesuaikan bila perlu):
#Environment=PLC_REG_STATE=0
#Environment=PLC_REG_PBCOUNTER=1
# '+' = dijalankan sebagai root: kunci clock CPU/GPU ke maksimum
ExecStartPre=+/usr/bin/jetson_clocks
ExecStart=__DIR__/run.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
